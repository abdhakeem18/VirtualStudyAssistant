{
  "expo": {
    "name": "Virtual Study Assistant",
    "slug": "virtual-study-assistant",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "userInterfaceStyle": "automatic",
    "scheme": "virtualstudyassistant",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "web": {
      "bundler": "metro"
    },
    "android": {
      "package": "com.abdulhakeem.virtualstudyassistant",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "5e96c4c9-18e5-4569-a183-4fcf55c1618e"
      }
    }
  }
}
